rules_version = '2';

// Cada persona solo puede leer y escribir sus propios datos.
service cloud.firestore {
  match /databases/{database}/documents {

    function esDueno(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    match /usuarios/{uid} {
      allow read, write: if esDueno(uid);

      match /movimientos/{movimientoId} {
        allow read, delete: if esDueno(uid);
        allow create, update: if esDueno(uid) && movimientoValido(movimientoId);
      }
    }

    function movimientoValido(movimientoId) {
      let m = request.resource.data;
      return m.id == movimientoId
        && m.tipo in ['ingreso', 'gasto']
        && m.monto is number && m.monto >= 0
        && m.propina is number && m.propina >= 0
        && m.metodo in ['efectivo', 'digital']
        && m.fecha is string && m.fecha.size() == 16
        && m.categoria is string && m.categoria.size() <= 40
        && m.plataforma is string && m.plataforma.size() <= 40
        && m.nota is string && m.nota.size() <= 120;
    }
  }
}
